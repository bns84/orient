# ORIENT Phase 1 — optional, keine Cloud-Pflicht
# Kopieren nach .env.local für lokale Overrides

# KI-Verarbeitung (Standard: aus — App bleibt voll nutzbar)
VITE_AI_ENABLED=false

# Standard: der ORIENT-Pförtner (http://127.0.0.1:8787). Schlüssel stehen NUR in server/.env.
# VITE_ORIENT_SERVER_URL=http://127.0.0.1:8787
# Nur falls ein anderes OpenAI-kompatibles Ziel gewünscht ist:
# VITE_AI_API_URL=https://openrouter.ai/api/v1
# VITE_AI_MODEL=gpt-4o-mini
