# ORIENT-Pförtner — Einstellungen
# Kopiere diese Datei als  server\.env  und trage deine Schlüssel ein.
# Die Datei .env bleibt auf deinem Rechner (wird nicht hochgeladen).

# Welche KI antwortet:  anthropic (Claude)  |  openai (ChatGPT)  |  mock (Ersatz, kostet nichts)
ORIENT_MODEL=anthropic

# Schlüssel
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Modellnamen (nur ändern, wenn du ein anderes Modell willst)
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-6.1-sol

# Tageslimit in Dollar (auch per Sprache änderbar: „Tageslimit auf 3 Dollar“)
ORIENT_DAILY_LIMIT_USD=2

# Die drei Schrauben für einen späteren Umzug:
# ORIENT_HOST=127.0.0.1
# ORIENT_PORT=8787
# ORIENT_DB_PATH=server/data/orient-brain.sqlite

# Das Ohr (Sprache zu Text). Der Dolmetscher ist ein kleines Programm mit Whisper auf diesem Rechner.
# Seine Adresse ist die vierte Schraube:
# ORIENT_EAR_URL=http://127.0.0.1:8788
# Modellgroesse: tiny | base | small | medium | large-v3   (small = guter Mittelweg fuer Deutsch ohne Grafikkarte)
# ORIENT_WHISPER_MODEL=small
# Grafikkarte nutzen (braucht CUDA 12): ORIENT_WHISPER_DEVICE=cuda und ORIENT_WHISPER_COMPUTE=float16
# ORIENT_WHISPER_DEVICE=cpu
# ORIENT_WHISPER_COMPUTE=int8
# Ersatz-Ohr ohne Python (liefert nur einen Testsatz): ORIENT_EAR=mock
